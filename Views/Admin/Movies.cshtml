@model IEnumerable<NetflixClone.Models.Movie>

@{
    ViewData["Title"] = "Manage Movies";
}

<style>
    body {
        background: #141414;
        color: white;
    }

    .admin-page {
        padding: 40px 30px;
        min-height: 85vh;
    }

    .page-title {
        font-size: 32px;
        font-weight: bold;
        margin-bottom: 25px;
    }

    .add-btn {
        background: #e50914;
        color: white;
        padding: 10px 20px;
        text-decoration: none;
        border-radius: 4px;
    }

        .add-btn:hover {
            background: #f40612;
            color: white;
        }

    .movie-table {
        background: #222;
        color: white;
        border-radius: 5px;
        overflow: hidden;
    }

        .movie-table th {
            background: #333;
            color: white;
            padding: 15px;
        }

        .movie-table td {
            padding: 15px;
            vertical-align: middle;
            border-color: #444;
        }

    .movie-poster {
        width: 60px;
        height: 80px;
        object-fit: cover;
        border-radius: 4px;
    }

    .edit-btn {
        background: #555;
        color: white;
        padding: 7px 14px;
        text-decoration: none;
        border-radius: 4px;
        margin-right: 5px;
    }

        .edit-btn:hover {
            background: #777;
            color: white;
        }

    .delete-btn {
        background: #e50914;
        color: white;
        border: none;
        padding: 7px 14px;
        border-radius: 4px;
    }

        .delete-btn:hover {
            background: #f40612;
        }

    .back-link {
        color: #aaa;
        text-decoration: none;
    }

        .back-link:hover {
            color: white;
        }
</style>

<div class="container-fluid admin-page">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h1 class="page-title">
            Manage Movies
        </h1>

        <a asp-controller="Admin"
               asp-action="CreateMovie"
               class="add-btn">
            + Add Movie
        </a>

    </div>


    @if (!Model.Any())
    {
        <div class="alert alert-dark">
            No movies found. Add your first movie.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table movie-table">

                <thead>
                    <tr>
                        <th>Poster</th>
                        <th>Title</th>
                        <th>Category</th>
                        <th>Year</th>
                        <th>Duration</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var movie in Model)
                    {
                        <tr>

                            <td>
                                @if (!string.IsNullOrEmpty(movie.PosterUrl))
                                {
                                    <img src="@movie.PosterUrl"
                                         class="movie-poster"
                                         alt="@movie.Title" />
                                }
                                else
                                {
                                    <div>
                                        🎬
                                    </div>
                                }
                            </td>

                            <td>
                                <strong>@movie.Title</strong>
                            </td>

                            <td>
                                @(movie.Category?.Name ?? "No Category")
                            </td>

                            <td>
                                @movie.ReleaseYear
                            </td>

                            <td>
                                @movie.Duration min
                            </td>

                            <td>

                                <a asp-controller="Admin"
                                       asp-action="EditMovie"
                                       asp-route-id="@movie.Id"
                                       class="edit-btn">
                                    Edit
                                </a>

                                <form asp-controller="Admin"
                                      asp-action="DeleteMovie"
                                      asp-route-id="@movie.Id"
                                      method="post"
                                      style="display:inline;">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="delete-btn"
                                            onclick="return confirm('Are you sure you want to delete this movie?');">
                                        Delete
                                    </button>

                                </form>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

    <div class="mt-4">

        <a asp-controller="Admin"
               asp-action="Index"
               class="back-link">
            ← Back to Dashboard
        </a>

    </div>

</div>