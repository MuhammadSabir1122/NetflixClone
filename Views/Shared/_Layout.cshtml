<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Netflix Clone</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <style>
            body {
                background: #141414;
                color: white;
            }

            .navbar {
                background: #141414 !important;
            }

            .navbar-brand {
                color: #e50914 !important;
                font-size: 26px;
                font-weight: bold;
            }

            .nav-link {
                color: #ddd !important;
                margin-right: 15px;
            }

                .nav-link:hover {
                    color: white !important;
                }

            .logout-link {
                color: #aaa !important;
            }

                .logout-link:hover {
                    color: white !important;
                }

            footer {
                background: #141414;
                color: #777;
                border-top: 1px solid #333;
            }
    </style>
</head>

<body>

    <header>

        <nav class="navbar navbar-expand-lg navbar-dark">

            <div class="container-fluid">

                <!-- Logo -->

                <a class="navbar-brand"
                       asp-controller="Home"
                       asp-action="Index">
                    NETFLIX
                </a>


                <!-- Mobile Button -->

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarContent">

                    <span class="navbar-toggler-icon"></span>

                </button>


                <div class="collapse navbar-collapse"
                     id="navbarContent">

                    <!-- Navigation -->

                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                        <li class="nav-item">

                            <a class="nav-link"
                                   asp-controller="Home"
                                   asp-action="Index">
                                Home
                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link"
                                   asp-controller="Movies"
                                   asp-action="Index">
                                Movies
                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link"
                                   asp-controller="Movies"
                                   asp-action="Search">
                                🔍 Search
                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link"
                                   asp-controller="MyList"
                                   asp-action="Index">
                                ❤️ My List
                            </a>

                        </li>

                    </ul>


                    <!-- Right Side -->

                    <ul class="navbar-nav">

                        @if (Context.Session.GetInt32("UserId") != null)
                        {
                            <li class="nav-item">

                                <span class="nav-link">
                                    Hi, @Context.Session.GetString("UserName")
                                </span>

                            </li>

                            <li class="nav-item">

                                <a class="nav-link logout-link"
                                       asp-controller="Account"
                                       asp-action="Logout">
                                    Logout
                                </a>

                            </li>
                        }
                        else if (Context.Session.GetInt32("AdminId") != null)
                        {
                            <li class="nav-item">

                                <span class="nav-link">
                                    Admin
                                </span>

                            </li>

                            <li class="nav-item">

                                <a class="nav-link"
                                       asp-controller="Admin"
                                       asp-action="Index">
                                    Dashboard
                                </a>

                            </li>

                            <li class="nav-item">

                                <a class="nav-link logout-link"
                                       asp-controller="Account"
                                       asp-action="Logout">
                                    Logout
                                </a>

                            </li>
                        }
                        else
                        {
                            <li class="nav-item">

                                <a class="nav-link"
                                       asp-controller="Account"
                                       asp-action="ChooseRole">
                                    Login
                                </a>

                            </li>
                        }

                    </ul>

                </div>

            </div>

        </nav>

    </header>


    <main>
        @RenderBody()
    </main>


    <footer class="text-center py-3">

        <div class="container">
            Netflix Clone © 2026
        </div>

    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>