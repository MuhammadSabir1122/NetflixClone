@{
    ViewData["Title"] = "User Login";
}

<style>
    body {
        background: #141414;
        color: white;
    }

    .login-page {
        min-height: 85vh;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .login-box {
        background: #222;
        width: 400px;
        padding: 40px;
        border-radius: 8px;
    }

    .login-title {
        font-size: 30px;
        font-weight: bold;
        margin-bottom: 30px;
        text-align: center;
    }

    .form-control {
        background: #333;
        border: 1px solid #555;
        color: white;
    }

        .form-control:focus {
            background: #333;
            color: white;
            border-color: #888;
            box-shadow: none;
        }

    .login-btn {
        background: #e50914;
        color: white;
        border: none;
        width: 100%;
        padding: 12px;
        font-weight: bold;
        border-radius: 4px;
    }

        .login-btn:hover {
            background: #f40612;
        }

    .register-link {
        color: #aaa;
        text-decoration: none;
    }

        .register-link:hover {
            color: white;
        }
</style>


<div class="login-page">

    <div class="login-box">

        <h2 class="login-title">
            User Login
        </h2>


        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">
                @ViewBag.Error
            </div>
        }


        <form asp-controller="Account"
              asp-action="Login"
              method="post">

            @Html.AntiForgeryToken()

            <div class="mb-3">

                <label class="form-label">
                    Email
                </label>

                <input type="email"
                       name="email"
                       class="form-control"
                       placeholder="Enter your email"
                       required />

            </div>


            <div class="mb-4">

                <label class="form-label">
                    Password
                </label>

                <input type="password"
                       name="password"
                       class="form-control"
                       placeholder="Enter your password"
                       required />

            </div>


            <button type="submit"
                    class="login-btn">
                Login
            </button>

        </form>


        <div class="text-center mt-4">

            <span class="text-secondary">
                New to Netflix Clone?
            </span>

            <a asp-controller="Account"
                   asp-action="Register"
                   class="register-link">
                Register now
            </a>

        </div>


        <div class="text-center mt-3">

            <a asp-controller="Account"
                   asp-action="ChooseRole"
                   class="register-link">
                ← Back
            </a>

        </div>

    </div>

</div>