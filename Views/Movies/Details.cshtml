@model NetflixClone.Models.Movie

@{
    ViewData["Title"] = Model.Title;
}

<style>
    body {
        background: #141414;
        color: white;
    }

    .details-page {
        min-height: 85vh;
        padding: 50px;
    }

    .movie-poster {
        width: 100%;
        max-height: 500px;
        object-fit: cover;
        border-radius: 8px;
    }

    .movie-title {
        font-size: 42px;
        font-weight: bold;
        margin-bottom: 20px;
    }

    .movie-description {
        color: #bbb;
        font-size: 17px;
        line-height: 1.7;
        margin: 20px 0;
    }

    .movie-info {
        color: #aaa;
        margin-bottom: 20px;
    }

    .btn-netflix {
        background: #e50914;
        color: white;
        border: none;
        padding: 12px 25px;
        border-radius: 5px;
        text-decoration: none;
        font-weight: bold;
    }

        .btn-netflix:hover {
            background: #f40612;
            color: white;
        }

    .btn-list {
        background: #444;
        color: white;
        border: none;
        padding: 12px 25px;
        border-radius: 5px;
        font-weight: bold;
    }

        .btn-list:hover {
            background: #666;
        }
</style>


<div class="container details-page">

    <div class="row align-items-center">

        <!-- Poster -->

        <div class="col-md-5 mb-4">

            @if (!string.IsNullOrEmpty(Model.PosterUrl))
            {
                <img src="@Model.PosterUrl"
                     alt="@Model.Title"
                     class="movie-poster" />
            }
            else
            {
                <div class="movie-poster d-flex justify-content-center align-items-center"
                     style="background:#333; font-size:80px;">
                    🎬
                </div>
            }

        </div>


        <!-- Movie Information -->

        <div class="col-md-7">

            <h1 class="movie-title">
                @Model.Title
            </h1>


            <div class="movie-info">

                <span>
                    @Model.ReleaseYear
                </span>

                <span class="mx-2">•</span>

                <span>
                    @Model.Duration minutes
                </span>

                @if (Model.Category != null)
                {
                    <span class="mx-2">•</span>

                    <span>
                        @Model.Category.Name
                    </span>
                }

            </div>


            <p class="movie-description">
                @Model.Description
            </p>


            <!-- Watch -->
            @if (!string.IsNullOrEmpty(Model.VideoUrl))
            {
                <a href="@Model.VideoUrl"
                       target="_blank"
                       class="btn-netflix me-2">
                    ▶ Watch Now
                </a>
            }


            <!-- Add To My List -->

            <form asp-controller="MyList"
                  asp-action="Add"
                  method="post"
                  style="display:inline;">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="movieId"
                       value="@Model.Id" />

                <button type="submit"
                        class="btn-list">
                    + My List
                </button>

            </form>

        </div>

    </div>

</div>