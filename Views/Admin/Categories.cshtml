@model IEnumerable<NetflixClone.Models.Category>

@{
    ViewData["Title"] = "Manage Categories";
}

<style>
    body {
        background: #141414;
        color: white;
    }

    .admin-page {
        padding: 40px 30px;
        min-height: 85vh;
    }

    .page-title {
        font-size: 32px;
        font-weight: bold;
        margin-bottom: 25px;
    }

    .add-btn {
        background: #e50914;
        color: white;
        padding: 10px 20px;
        text-decoration: none;
        border-radius: 4px;
    }

        .add-btn:hover {
            background: #f40612;
            color: white;
        }

    .category-table {
        background: #222;
        color: white;
        border-radius: 5px;
        overflow: hidden;
    }

        .category-table th {
            background: #333;
            color: white;
            padding: 15px;
        }

        .category-table td {
            padding: 15px;
            vertical-align: middle;
            border-color: #444;
        }

    .edit-btn {
        background: #555;
        color: white;
        padding: 7px 14px;
        text-decoration: none;
        border-radius: 4px;
        margin-right: 5px;
    }

        .edit-btn:hover {
            background: #777;
            color: white;
        }

    .delete-btn {
        background: #e50914;
        color: white;
        border: none;
        padding: 7px 14px;
        border-radius: 4px;
    }

        .delete-btn:hover {
            background: #f40612;
        }

    .back-link {
        color: #aaa;
        text-decoration: none;
    }

        .back-link:hover {
            color: white;
        }
</style>

<div class="container-fluid admin-page">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <h1 class="page-title">
            Manage Categories
        </h1>

        <a asp-controller="Admin"
               asp-action="CreateCategory"
               class="add-btn">
            + Add Category
        </a>

    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-dark">
            No categories found. Add your first category.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table category-table">

                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Name</th>
                        <th>Description</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var category in Model)
                    {
                        <tr>

                            <td>
                                @category.Id
                            </td>

                            <td>
                                <strong>@category.Name</strong>
                            </td>

                            <td>
                                @(category.Description ?? "No description")
                            </td>

                            <td>

                                <a asp-controller="Admin"
                                       asp-action="EditCategory"
                                       asp-route-id="@category.Id"
                                       class="edit-btn">
                                    Edit
                                </a>

                                <form asp-controller="Admin"
                                      asp-action="DeleteCategory"
                                      asp-route-id="@category.Id"
                                      method="post"
                                      style="display:inline;">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="delete-btn"
                                            onclick="return confirm('Are you sure you want to delete this category?');">
                                        Delete
                                    </button>

                                </form>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

    <div class="mt-4">

        <a asp-controller="Admin"
               asp-action="Index"
               class="back-link">
            ← Back to Dashboard
        </a>

    </div>

</div>