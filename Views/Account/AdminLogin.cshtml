@{
    ViewData["Title"] = "Admin Login";
}

<style>
    body {
        background: #141414;
        color: white;
    }

    .admin-login {
        min-height: 85vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .login-box {
        width: 400px;
        background: #000;
        padding: 45px;
        border-radius: 5px;
    }

    .login-title {
        font-size: 30px;
        font-weight: bold;
        margin-bottom: 25px;
    }

    .login-input {
        background: #333;
        border: none;
        color: white;
        padding: 14px;
        margin-bottom: 15px;
    }

        .login-input::placeholder {
            color: #aaa;
        }

    .login-btn {
        background: #e50914;
        border: none;
        color: white;
        font-weight: bold;
        padding: 13px;
        width: 100%;
    }

        .login-btn:hover {
            background: #f40612;
            color: white;
        }

    .error {
        background: #e87c03;
        padding: 10px;
        margin-bottom: 15px;
    }
</style>

<div class="admin-login">

    <div class="login-box">

        <div class="login-title">
            Admin Sign In
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="error">
                @ViewBag.Error
            </div>
        }

        <form asp-action="AdminLogin" method="post">

            @Html.AntiForgeryToken()

            <input type="email"
                   name="email"
                   class="form-control login-input"
                   placeholder="Admin Email"
                   required />

            <input type="password"
                   name="password"
                   class="form-control login-input"
                   placeholder="Password"
                   required />

            <button type="submit"
                    class="btn login-btn">
                Admin Sign In
            </button>

        </form>

        <div class="mt-4 text-center">
            <a asp-action="ChooseRole"
                   style="color:#aaa;">
                ← Back
            </a>
        </div>

    </div>

</div>