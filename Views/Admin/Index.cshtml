@{
    ViewData["Title"] = "Admin Dashboard";
}

<style>
    body {
        background: #141414;
        color: white;
    }

    .admin-dashboard {
        min-height: 85vh;
        padding: 50px 30px;
    }

    .dashboard-title {
        font-size: 36px;
        font-weight: bold;
        margin-bottom: 10px;
    }

    .dashboard-subtitle {
        color: #aaa;
        margin-bottom: 40px;
    }

    .admin-card {
        background: #222;
        border-radius: 6px;
        padding: 30px;
        height: 100%;
        transition: 0.2s;
    }

        .admin-card:hover {
            background: #2d2d2d;
            transform: translateY(-3px);
        }

    .card-icon {
        font-size: 40px;
        margin-bottom: 15px;
    }

    .card-title {
        font-size: 22px;
        font-weight: bold;
        margin-bottom: 10px;
    }

    .card-text {
        color: #aaa;
        margin-bottom: 25px;
    }

    .netflix-btn {
        background: #e50914;
        color: white;
        border: none;
        padding: 10px 20px;
        text-decoration: none;
        border-radius: 4px;
        display: inline-block;
    }

        .netflix-btn:hover {
            background: #f40612;
            color: white;
        }

    .logout-btn {
        margin-top: 40px;
        color: #aaa;
        text-decoration: none;
    }

        .logout-btn:hover {
            color: white;
        }
</style>

<div class="container admin-dashboard">

    <h1 class="dashboard-title">
        Admin Dashboard
    </h1>

    <p class="dashboard-subtitle">
        Welcome to Netflix Clone Admin Panel
    </p>

    <div class="row g-4">

        <!-- Movies -->
        <div class="col-md-6">

            <div class="admin-card">

                <div class="card-icon">
                    🎬
                </div>

                <div class="card-title">
                    Manage Movies
                </div>

                <div class="card-text">
                    Add, edit and delete movies from the Netflix catalog.
                </div>

                <a asp-controller="Admin"
                       asp-action="Movies"
                       class="netflix-btn">
                    Manage Movies
                </a>

            </div>

        </div>


        <!-- Categories -->
        <div class="col-md-6">

            <div class="admin-card">

                <div class="card-icon">
                    📂
                </div>

                <div class="card-title">
                    Manage Categories
                </div>

                <div class="card-text">
                    Create, edit and delete movie categories.
                </div>

                <a asp-controller="Admin"
                       asp-action="Categories"
                       class="netflix-btn">
                    Manage Categories
                </a>

            </div>

        </div>

    </div>


    <!-- Logout -->

    <div class="mt-5">

        <a asp-controller="Account"
               asp-action="Logout"
               class="logout-btn">
            ← Logout
        </a>

    </div>

</div>