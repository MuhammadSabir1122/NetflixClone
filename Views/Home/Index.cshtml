@model IEnumerable<NetflixClone.Models.Movie>

@{
    ViewData["Title"] = "Home";
}

<style>
    body {
        background: #141414;
        color: white;
    }

    .home-page {
        min-height: 90vh;
        padding-bottom: 50px;
    }

    /* Hero Section */

    .hero {
        background: linear-gradient(
            to right,
            #141414 20%,
            rgba(20, 20, 20, 0.7),
            rgba(20, 20, 20, 0.2)
        );
        padding: 100px 50px;
        min-height: 400px;
    }

    .hero h1 {
        font-size: 48px;
        font-weight: bold;
    }

    .hero p {
        color: #ccc;
        max-width: 550px;
        font-size: 18px;
    }

    .hero-btn {
        background: white;
        color: black;
        padding: 12px 25px;
        border-radius: 4px;
        text-decoration: none;
        display: inline-block;
        margin-top: 15px;
        font-weight: bold;
    }

    .hero-btn:hover {
        background: #ddd;
        color: black;
    }

    /* Movies */

    .movies-section {
        padding: 30px 40px;
    }

    .section-title {
        font-size: 26px;
        font-weight: bold;
        margin-bottom: 20px;
    }

    .movie-card {
        background: #222;
        border-radius: 5px;
        overflow: hidden;
        height: 100%;
        transition: 0.2s;
    }

    .movie-card:hover {
        transform: scale(1.03);
    }

    .movie-poster {
        width: 100%;
        height: 280px;
        object-fit: cover;
    }

    .movie-info {
        padding: 15px;
    }

    .movie-title {
        font-size: 18px;
        font-weight: bold;
        margin-bottom: 5px;
    }

    .movie-category {
        color: #aaa;
        font-size: 14px;
    }

    .details-btn {
        display: inline-block;
        margin-top: 12px;
        background: #e50914;
        color: white;
        padding: 7px 14px;
        text-decoration: none;
        border-radius: 4px;
    }

    .details-btn:hover {
        background: #f40612;
        color: white;
    }
</style>


<div class="home-page">

    <!-- HERO -->

    <section class="hero">

        <h1>Netflix Clone</h1>

        <p>
            Watch your favorite movies and discover new stories.
            Explore our collection and build your personal list.
        </p>

        <a asp-controller="Movies"
               asp-action="Index"
               class="hero-btn">
            ▶ Browse Movies
        </a>

    </section>


    <!-- MOVIES -->

    <section class="movies-section">

        <h2 class="section-title">
            Popular Movies
        </h2>

        @if (Model == null || !Model.Any())
        {
            <p class="text-secondary">
                No movies available yet.
            </p>
        }
        else
        {
            <div class="row g-4">

                @foreach (var movie in Model)
                {
                    <div class="col-lg-2 col-md-3 col-sm-4 col-6">

                        <div class="movie-card">

                            @if (!string.IsNullOrEmpty(movie.PosterUrl))
                            {
                                <img src="@movie.PosterUrl"
                                     class="movie-poster"
                                     alt="@movie.Title" />
                            }
                            else
                            {
                                <div class="movie-poster d-flex align-items-center justify-content-center">
                                    🎬
                                </div>
                            }

                            <div class="movie-info">

                                <div class="movie-title">
                                    @movie.Title
                                </div>

                                <div class="movie-category">
                                    @(movie.Category?.Name ?? "No Category")
                                </div>

                                <a asp-controller="Movies"
                                       asp-action="Details"
                                       asp-route-id="@movie.Id"
                                       class="details-btn">
                                    Details
                                </a>

                            </div>

                        </div>

                    </div>
                }

            </div>
        }

    </section>

</div>